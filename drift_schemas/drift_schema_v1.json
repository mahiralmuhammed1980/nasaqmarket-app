  "fixed_sql": [
    {
      "name": "catalog_companies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_companies\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"country\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "catalog_drugs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_drugs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"barcode\" TEXT NULL UNIQUE, \"trade_name\" TEXT NOT NULL, \"scientific_name\" TEXT NOT NULL DEFAULT '', \"category\" TEXT NOT NULL DEFAULT '', \"unit\" TEXT NOT NULL DEFAULT '', \"company_id\" INTEGER NULL REFERENCES catalog_companies (id), \"reference_price\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "suppliers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"suppliers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"contact\" TEXT NOT NULL DEFAULT '', \"phone\" TEXT NOT NULL DEFAULT '', \"email\" TEXT NOT NULL DEFAULT '', \"city\" TEXT NOT NULL DEFAULT '', \"address\" TEXT NOT NULL DEFAULT '', \"payment_terms\" TEXT NOT NULL DEFAULT '', \"notes\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"catalog_drug_id\" INTEGER NULL REFERENCES catalog_drugs (id), \"name\" TEXT NOT NULL, \"scientific_name\" TEXT NOT NULL DEFAULT '', \"category\" TEXT NOT NULL DEFAULT '', \"unit\" TEXT NOT NULL DEFAULT 'علبة', \"sale_price\" INTEGER NOT NULL DEFAULT 0, \"cost_price\" INTEGER NOT NULL DEFAULT 0, \"min_stock\" INTEGER NOT NULL DEFAULT 0, \"barcode\" TEXT NULL, \"default_supplier_id\" INTEGER NULL REFERENCES suppliers (id), \"notes\" TEXT NOT NULL DEFAULT '', \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "batches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"batches\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"product_id\" INTEGER NOT NULL REFERENCES products (id), \"batch_no\" TEXT NOT NULL DEFAULT '', \"quantity\" INTEGER NOT NULL DEFAULT 0, \"expiry\" INTEGER NULL, \"cost\" INTEGER NOT NULL DEFAULT 0, \"location\" TEXT NOT NULL DEFAULT '', \"supplier_id\" INTEGER NULL REFERENCES suppliers (id), \"notes\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "purchase_orders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"purchase_orders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"supplier_id\" INTEGER NOT NULL REFERENCES suppliers (id), \"status\" TEXT NOT NULL DEFAULT 'draft', \"created_at\" INTEGER NOT NULL, \"received_at\" INTEGER NULL, \"notes\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "purchase_order_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"purchase_order_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"order_id\" INTEGER NOT NULL REFERENCES purchase_orders (id), \"product_id\" INTEGER NOT NULL REFERENCES products (id), \"quantity\" INTEGER NOT NULL, \"unit_cost\" INTEGER NOT NULL, \"batch_no\" TEXT NOT NULL DEFAULT '', \"expiry\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "invoices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoices\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"number\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL, \"patient_name\" TEXT NOT NULL, \"patient_phone\" TEXT NOT NULL DEFAULT '', \"subtotal\" INTEGER NOT NULL, \"discount\" INTEGER NOT NULL DEFAULT 0, \"total\" INTEGER NOT NULL, \"payment_method\" TEXT NOT NULL DEFAULT 'cash', \"payment_status\" TEXT NOT NULL DEFAULT 'paid', \"paid_amount\" INTEGER NOT NULL DEFAULT 0, \"notes\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "invoice_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"invoice_id\" INTEGER NOT NULL REFERENCES invoices (id), \"product_id\" INTEGER NULL REFERENCES products (id), \"product_name\" TEXT NOT NULL, \"quantity\" INTEGER NOT NULL, \"unit_price\" INTEGER NOT NULL, \"unit_cost\" INTEGER NOT NULL DEFAULT 0, \"line_total\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "invoice_item_batches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_item_batches\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"invoice_item_id\" INTEGER NOT NULL REFERENCES invoice_items (id), \"batch_id\" INTEGER NOT NULL REFERENCES batches (id), \"quantity\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
